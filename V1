-- ✨ 平滑拖曳邏輯
local dragging = false
local dragStart, startPos
local targetPosition = Frame.Position

local function initDrag(inputObject)
    inputObject.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = Frame.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
end

initDrag(TopHeader)
initDrag(Title)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        targetPosition = UDim2.new(
            startPos.X.Scale, 
            startPos.X.Offset + delta.X, 
            startPos.Y.Scale, 
            startPos.Y.Offset + delta.Y
        )
    end
end)

RunService.RenderStepped:Connect(function()
    if dragging then
        local currentPos = Frame.Position
        local smoothX = currentPos.X.Offset + (targetPosition.X.Offset - currentPos.X.Offset) * 0.35
        local smoothY = currentPos.Y.Offset + (targetPosition.Y.Offset - currentPos.Y.Offset) * 0.35
        
        Frame.Position = UDim2.new(
            currentPos.X.Scale, 
            smoothX, 
            currentPos.Y.Scale, 
            smoothY
        )
    end
end)

