local UIListLayout = Instance.new("UIListLayout", SearchResultsScroll)
UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
UIListLayout.Padding = UDim.new(0, 5)

local function performScriptBloxSearch()
    local query = SearchBox.Text
    if query == "" then return end
    
    for _, child in pairs(SearchResultsScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    local success, response = pcall(function()
        return game:HttpGet("https://scriptblox.com/api/script/search?q=" .. HttpService:UrlEncode(query))
    end)
    
    if success and response then
        local data = HttpService:JSONDecode(response)
        if data and data.result and data.result.scripts then
            local scripts = data.result.scripts
            SearchResultsScroll.CanvasSize = UDim2.new(0, 0, 0, #scripts * 35)
            
            for i, scriptData in ipairs(scripts) do
                local title = scriptData.title or "Script"
                local gameName = (scriptData.game and scriptData.game.name) or "Universal"
                local displayText = "  " .. title .. " - (" .. gameName .. ") Script"
                
                local resultBtn = createButton(SearchResultsScroll, "Res_"..i, displayText, UDim2.new(1, 0, 0, 30), UDim2.new(0,0,0,0), Color3.fromRGB(45, 45, 50))
                resultBtn.TextSize = 11
                resultBtn.TextXAlignment = Enum.TextXAlignment.Left
                resultBtn.TextTruncate = Enum.TextTruncate.AtEnd
                
                resultBtn.MouseButton1Click:Connect(function()
                    pcall(function()
                        local rawRes = game:HttpGet("https://scriptblox.com/api/script/raw/" .. scriptData.slug)
                        if rawRes then
                            local runFunc = loadstring(rawRes)
                            if runFunc then runFunc() end
                        end
                    end)
                end)
            end
        end
    end
end

SearchSubmitBtn.MouseButton1Click:Connect(performScriptBloxSearch)
SearchBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then performScriptBloxSearch() end
end)


