-- ==================== 📑 下方 Tabs 切換列 (5個 Tabs 支援) ====================
local TabsBar = Instance.new("Frame", Frame)
TabsBar.Size = UDim2.new(1, -20, 0, 30)
TabsBar.Position = UDim2.new(0, 10, 1, -38)
TabsBar.BackgroundColor3 = Color3.fromRGB(35, 35, 38)
Instance.new("UICorner", TabsBar).CornerRadius = UDim.new(0, 6)

local function createTabButton(name, text, positionX)
    local tabBtn = Instance.new("TextButton", TabsBar)
    tabBtn.Size = UDim2.new(0.19, 0, 1, 0)
    tabBtn.Position = positionX
    tabBtn.BackgroundTransparency = 1
    tabBtn.Text = text
    tabBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
    tabBtn.Font = Enum.Font.GothamBold
    tabBtn.TextSize = 11
    return tabBtn
end

MainTab = createTabButton("MainTab", L("MainTab"), UDim2.new(0.01, 0, 0, 0))
SettingsTab = createTabButton("SettingsTab", L("SettingsTab"), UDim2.new(0.21, 0, 0, 0))
ScriptsTab = createTabButton("ScriptsTab", L("ScriptsTab"), UDim2.new(0.41, 0, 0, 0))
SearchTab = createTabButton("SearchTab", L("SearchTab"), UDim2.new(0.61, 0, 0, 0))
InfoTab = createTabButton("InfoTab", L("InfoTab"), UDim2.new(0.81, 0, 0, 0))

local function switchTab(selectedPanel, selectedBtn)
    MainPanel.Visible = false
    SettingsPanel.Visible = false
    ScriptsPanel.Visible = false
    SearchPanel.Visible = false
    InfoPanel.Visible = false
    
    MainTab.TextColor3 = Color3.fromRGB(150, 150, 150)
    SettingsTab.TextColor3 = Color3.fromRGB(150, 150, 150)
    ScriptsTab.TextColor3 = Color3.fromRGB(150, 150, 150)
    SearchTab.TextColor3 = Color3.fromRGB(150, 150, 150)
    InfoTab.TextColor3 = Color3.fromRGB(150, 150, 150)
    
    selectedPanel.Visible = true
    selectedBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
end

MainTab.TextColor3 = Color3.fromRGB(255, 255, 255)

MainTab.MouseButton1Click:Connect(function() switchTab(MainPanel, MainTab) end)
SettingsTab.MouseButton1Click:Connect(function() switchTab(SettingsPanel, SettingsTab) end)
ScriptsTab.MouseButton1Click:Connect(function() switchTab(ScriptsPanel, ScriptsTab) end)
SearchTab.MouseButton1Click:Connect(function() switchTab(SearchPanel, SearchTab) end)
InfoTab.MouseButton1Click:Connect(function() switchTab(InfoPanel, InfoTab) end)
